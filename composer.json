{
    "name": "terminal42/contao-build-tools",
    "type": "composer-plugin",
    "description": "Highly opinionated build tool setup for Contao websites.",
    "keywords": ["contao", "ci", "cq", "code-style", "rector"],
    "homepage": "https://github.com/terminal42/contao-build-tools",
    "license": "MIT",
    "authors": [
        {
            "name": "terminal42 gmbh",
            "homepage": "http://www.terminal42.ch"
        }
    ],
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/terminal42"
        },
        {
            "type": "other",
            "url": "https://ko-fi.com/terminal42"
        }
    ],
    "require": {
        "composer-plugin-api": "^2.0",
        "composer/semver": "^3.0"
    },
    "require-dev": {
        "deployer/deployer": "^7.0 || ^8.0",
        "composer/composer": "^1.1 || ^2.0"
    },
    "conflict": {
        "deployer/deployer": "< 7.0 || >= 9.0"
    },
    "autoload": {
        "psr-4": {
            "Terminal42\\ContaoBuildTools\\": "src/"
        }
    },
    "extra": {
        "class": "Terminal42\\ContaoBuildTools\\Composer\\Plugin"
    },
    "scripts": {
        "cs-fixer": "@php tools/ecs/vendor/bin/ecs check deployer src $(find tools -path '*/vendor' -prune -o -type f -name '*.php' -print) --config tools/ecs/config/contao.php --fix --ansi",
        "rector": "@php tools/rector/vendor/bin/rector process deployer src $(find tools -path '*/vendor' -prune -o -type f -name '*.php' -print) --config tools/rector/config.php --ansi"
    },
    "config": {
        "allow-plugins": {
            "terminal42/code-quality-tools": true,
            "contao/manager-plugin": false
        }
    }
}
